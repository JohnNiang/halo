{# Author posts page #}
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=2"/><title>Author — {{ site.title }}</title><link rel="stylesheet" crossorigin href="/themes/theme-earth-halot/assets/main-BaWd_1hx.css"></head>
<body class="bg-slate-50 dark:bg-slate-900">
  <header class="sticky top-0 z-10 flex h-16 items-center bg-white px-4 shadow-sm dark:bg-gray-800 lg:px-6">
    <a href="/" class="mr-6 flex items-center gap-2">{% if site.logo %}<img src="{{ site.logo }}" alt="logo" class="h-8 w-auto"/>{% endif %}<span class="text-lg font-medium text-gray-900 dark:text-slate-100">{{ site.title }}</span></a>
  </header>
  <section class="mx-auto mt-6 max-w-7xl px-4 lg:px-6">
    {% if author %}
    <div class="mb-8 flex items-center gap-4 rounded-xl bg-white p-6 shadow dark:bg-slate-800">
      {% if author.spec.avatar %}<img src="{{ author.spec.avatar }}" class="size-16 rounded-full" alt="{{ author.spec.displayName }}"/>{% endif %}
      <div><h1 class="text-2xl font-bold text-gray-900 dark:text-slate-100">{{ author.spec.displayName }}</h1><p class="text-sm text-gray-500">{{ author.status.postCount or 0 }} posts</p></div>
    </div>
    {% endif %}
    {% if posts.total > 0 %}
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {% for post in posts.items %}{% include "modules/post-card" %}{% endfor %}
    </div>
    {% else %}<p class="text-gray-400">No posts.</p>{% endif %}
  </section>
  <footer class="mt-10 bg-white py-8 dark:bg-slate-800"><div class="mx-auto max-w-7xl px-4 text-center text-sm text-gray-500 dark:text-slate-300 lg:px-6">&copy; {{ site.title }} &middot; Powered by Halo</div></footer>
</body></html>