{# Homepage — post list #}
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=2" />
  {% if site.logo %}<link rel="preload" href="{{ site.logo }}" as="image" />{% endif %}
  <title>{{ site.title }}</title>
  <link rel="stylesheet" crossorigin href="/themes/theme-earth-halot/assets/main-BaWd_1hx.css">
</head>
<body class="bg-slate-50 dark:bg-slate-900">

  {# ——— Header ——— #}
  {% set menu = menuFinder.getPrimary() %}
  <header class="sticky top-0 z-10 flex h-16 items-center bg-white px-4 shadow-sm dark:bg-gray-800 lg:px-6">
    <a href="/" class="mr-6 flex items-center gap-2">
      {% if site.logo %}<img src="{{ site.logo }}" alt="logo" class="h-8 w-auto" />{% endif %}
      <span class="text-lg font-medium text-gray-900 dark:text-slate-100">{{ site.title }}</span>
    </a>
    {% if menu.menuItems %}
    <nav class="hidden gap-6 sm:flex">
      {% for item in menu.menuItems %}
      <a href="{{ item.status.href }}" class="text-sm text-gray-600 hover:text-blue-600 dark:text-slate-300">{{ item.status.displayName }}</a>
      {% endfor %}
    </nav>
    {% endif %}
  </header>

  {# ——— Hero ——— #}
  <section class="bg-cover bg-center bg-no-repeat py-16" style="background-image: url('/themes/theme-earth-halot/assets/images/default-background.png')">
    <div class="mx-auto max-w-7xl px-4 text-center lg:px-6">
      <h1 class="text-4xl font-bold text-white drop-shadow-lg">{{ site.title }}</h1>
      {% if site.subtitle %}
      <p class="mt-3 text-lg text-white/80">{{ site.subtitle }}</p>
      {% endif %}
    </div>
  </section>

  {# ——— Content ——— #}
  <section class="mx-auto mt-6 grid max-w-7xl grid-cols-1 gap-6 px-4 md:grid-cols-[1fr_18rem] lg:px-6">
    <div class="min-w-0">
      {% if posts.total > 0 %}
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {% for post in posts.items %}
        {% include "modules/post-card" %}
        {% endfor %}
      </div>

      {# Pagination #}
      <div class="mt-8 flex justify-center gap-4">
        {% if posts.hasPrevious() %}
        <a href="{{ posts.prevUrl }}" class="rounded bg-white px-4 py-2 text-sm shadow hover:bg-gray-50 dark:bg-slate-800 dark:text-slate-200">&larr; Newer</a>
        {% endif %}
        {% if posts.hasNext() %}
        <a href="{{ posts.nextUrl }}" class="rounded bg-white px-4 py-2 text-sm shadow hover:bg-gray-50 dark:bg-slate-800 dark:text-slate-200">Older &rarr;</a>
        {% endif %}
      </div>
      {% else %}
      <div class="flex h-64 items-center justify-center rounded-xl bg-white dark:bg-slate-800">
        <p class="text-gray-400">No posts yet.</p>
      </div>
      {% endif %}
    </div>
    {% include "modules/sidebar" %}
  </section>

  {# ——— Footer ——— #}
  <footer class="mt-10 bg-white py-8 dark:bg-slate-800">
    <div class="mx-auto max-w-7xl px-4 text-center text-sm text-gray-500 dark:text-slate-300 lg:px-6">
      &copy; {{ site.title }} &middot; Powered by <a href="https://halo.run" class="hover:underline" target="_blank">Halo</a>
    </div>
  </footer>

</body>
</html>
